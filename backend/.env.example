# Copy this file to .env and fill in your values
PORT=5001

# AI Provider — set one of these
# Option A: OpenAI
OPENAI_API_KEY=sk-...

# Option B: Google Gemini
GEMINI_API_KEY=...

# Which AI provider to use: "openai" | "gemini" | "none"
AI_PROVIDER=none

# Optional: results are saved here (relative to backend/)
RESULTS_DIR=results
